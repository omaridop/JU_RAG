# ============================================================================
#  University of Jordan — Bilingual RAG Assistant
#  Copy this file to ".env" and fill in your OpenRouter key.
#  Only OPENROUTER_API_KEY is strictly required to boot.
# ============================================================================

# --- OpenRouter (one key for BOTH chat + embeddings) ------------------------
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: shown on OpenRouter's public rankings (safe to leave as-is)
OPENROUTER_REFERER=http://localhost:5000
OPENROUTER_TITLE=University of Jordan RAG Assistant

# --- Models (exact OpenRouter slugs) ----------------------------------------
CHAT_MODEL=deepseek/deepseek-v4-flash
EMBED_MODEL=google/gemini-embedding-2
# Reads documents (PDF natively / DOCX text) and chunks them. Needs a model with
# native PDF support (Gemini). gemini-2.5-flash recommended; -pro for hard scans.
CHUNK_MODEL=google/gemini-2.5-flash
# 0 = use the model's native dimensionality (gemini-embedding-2 => 3072).
# Set to 768 or 1536 to request smaller vectors (saves storage).
EMBED_DIM=0
EMBED_BATCH=64
EMBED_CONCURRENCY=4             # parallel embedding requests
EMBED_TIMEOUT_S=90              # per embedding request (seconds)
EMBED_MAX_CHARS=6000            # hard cap per embedded input

# --- Timeouts & concurrency --------------------------------------------------
LLM_TIMEOUT_S=120               # chat requests (seconds)
INGEST_TIMEOUT_S=600            # document reading / Q&A generation requests
INGEST_CONCURRENCY=4            # parallel page-batch calls during ingestion

# --- Document reading (LLM reads the file directly) -------------------------
PDF_INGEST_MODE=native          # native = LLM reads the PDF pages | text = PyMuPDF
PDF_ENGINE=native               # native | mistral-ocr (heavy scans) | cloudflare-ai
PDF_PAGES_PER_BATCH=6           # pages per model request (avoids truncation)
READ_MAX_TOKENS=16000           # max output tokens per read/chunk call
CHUNK_TARGET_WORDS=250          # target words per chunk (chunks strategy)
PDF_MAX_MB=50                   # above this, fall back to text extraction

# --- Q&A generation (documents -> bilingual Q&A knowledge base) -------------
INGEST_STRATEGY=qa              # qa = generate Q&A pairs (recommended) | chunks
QA_VARIANTS=4                   # min question paraphrases per language per fact
QA_PAGES_PER_BATCH=1            # one page per call: dense tables need the full budget
QA_MAX_TOKENS=32000             # max output tokens per Q&A generation call

# --- Generation tuning ------------------------------------------------------
CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=1200
# Reasoning effort for the chat model (it's a reasoning model — "thinking" tokens
# are the biggest latency cost; measured ~3.6s default vs ~1.3s off to 1st token).
# off = fastest and fine for grounded RAG; bump to low/medium for harder questions.
# Values: off | low | medium | high | default
CHAT_REASONING_EFFORT=off
CONDENSE_REASONING_EFFORT=off
WEB_AGENT_REASONING_EFFORT=low   # web-search agent needs some thinking to decide to search
CHUNK_TEMPERATURE=0.1

# --- Chunking ---------------------------------------------------------------
CHUNK_WINDOW_CHARS=12000
CHUNK_WINDOW_OVERLAP=800
FALLBACK_CHUNK_SIZE=1100
FALLBACK_CHUNK_OVERLAP=150

# --- Retrieval (recency-aware) ----------------------------------------------
COLLECTION_NAME=ju_knowledge
MEMORY_COLLECTION=ju_memory
TOP_K=10                        # QA records are short -> deeper top-k is cheap
CANDIDATE_K=48                  # over-fetch pool for recency re-rank + dedupe
SCORE_THRESHOLD=0.15
# Newest data wins on near-ties. 0 = ignore dates, 1 = rank purely by recency.
RECENCY_WEIGHT=0.18
RECENCY_HALFLIFE_DAYS=365

# --- Memory cache -----------------------------------------------------------
# How similar a new question must be to a saved memory to reuse its answer.
MEMORY_SIM_THRESHOLD=0.92

# --- Live JU web-search agent (student opts in per message) -----------------
WEB_SEARCH_ENABLED=true          # makes the composer "Search site" toggle AVAILABLE to students
WEB_SEARCH_DOMAIN=ju.edu.jo       # comma-separated; each entry also covers its subdomains
# Provider: auto = Serper (Google) if SERPER_API_KEY, else Tavily, else OpenRouter.
# Force with: serper | tavily | openrouter | duckduckgo
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=                   # https://tavily.com — synthesizes answers + extracts JS pages
TAVILY_SEARCH_DEPTH=advanced      # basic | advanced
WEB_SEARCH_INCLUDE_ANSWER=true    # Tavily returns a direct synthesized answer (big quality boost)
TAVILY_CHUNKS_PER_SOURCE=3
# BEST accuracy for ju.edu.jo: Google results via Serper. https://serper.dev
# (free tier, then ~$0.30-1 / 1000). Leave blank to use Tavily only.
SERPER_API_KEY=
SERPER_GL=jo                      # geo bias (Jordan)
SERPER_HL=ar                      # language bias (Arabic — JU site is Arabic-first)
WEB_SEARCH_RESULTS=6              # pages fetched per search
WEB_SEARCH_MAX_ITERS=3            # tool-call rounds per question
WEB_SEARCH_TIMEOUT_S=15
# Give the model the JU-site search tool on every message so it can look up
# anything the knowledge base doesn't cover (the model decides when to search).
WEB_SEARCH_AUTO=true

# --- Limits & conversation --------------------------------------------------
CHAT_LIMIT_PER_SESSION=30
CHAT_HISTORY_TURNS=4

# --- Web & admin ------------------------------------------------------------
# Generate a real one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Admin re-login on browser close + auto-logout after this many idle minutes
# (lower = stricter; 0 = only log out on browser close).
ADMIN_SESSION_MINUTES=30
MAX_UPLOAD_MB=40

# --- Deployment / security (turn these ON in production) --------------------
DEBUG=false                     # NEVER true in production (Werkzeug debugger = RCE)
COOKIE_SECURE=false             # true when served over HTTPS
TRUST_PROXY=false               # true ONLY behind a reverse proxy you control

# --- Abuse protection (public chat) -----------------------------------------
RATE_LIMIT_PER_MIN=12           # per-IP request ceilings (0 disables a window)
RATE_LIMIT_PER_HOUR=120
RATE_LIMIT_PER_DAY=600
MONTHLY_BUDGET_USD=0            # 0 = unlimited; also editable in the Cost page
## Optional read-aloud (OpenRouter; billed per input character, not token)
TTS_ENABLED=true
TTS_MODEL=elevenlabs/eleven-v4-turbo
TTS_VOICE=4wf10lgibMnboGJGCLrP
TTS_USD_PER_CHARACTER=0.00004
