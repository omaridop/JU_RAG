# Normalize line endings on commit; check out native on each platform.
* text=auto

# Keep these as LF regardless of platform.
*.py   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Treat as binary (no line-ending translation, no diff).
*.png binary
*.svg binary
